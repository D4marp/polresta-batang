NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only. Salin Session pooler dari Connect > Direct > Session pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SITE_URL=https://YOUR_OFFICIAL_DOMAIN
# Server-only, jangan memakai prefix NEXT_PUBLIC_ untuk secret key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=website-media
# Hanya untuk migrasi file lama; tidak diperlukan setelah pindah ke Storage.
# DATA_DIR=./data

# Opsional: pisahkan konfigurasi server Storage dari environment integrasi Vercel.
# SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_STORAGE_SECRET_KEY=sb_secret_REPLACE_ME
