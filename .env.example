ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
# Rahasia untuk menandatangani sesi login (string acak panjang)
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Opsional: lokasi penyimpanan data & upload (default: ./data)
# DATA_DIR=./data
# SQL Server — pilih salah satu:
# Windows Auth (lokal):
DATABASE_URL=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=polresta_batang;Trusted_Connection=yes;TrustServerCertificate=yes
# SQL login via TCP (produksi):
# DATABASE_URL=Server=host,1433;Database=polresta_batang;User Id=polresta_app;Password=GANTI;Encrypt=true;TrustServerCertificate=true
